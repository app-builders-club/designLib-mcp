{
  "id": "social_carousel_fullbleed_quote_series",
  "title": "Full-Bleed Quote Series",
  "description": "Quote carousel built on full-bleed image slots with a top-and-bottom scrim. Text sits in the lower third: a display-scale quote, an accent rule and a two-line attribution. The closing slide flips to a flat accent panel so the ask reads as a separate beat.",
  "why_it_works": "The dark scrim guarantees contrast whatever image the user drops in, so the quote stays readable without hand-tuning. Anchoring text to the lower third leaves the upper frame for a face or scene, which is what the eye lands on first in feed. Repeating the same frame for every quote makes the series recognisable at thumbnail size.",
  "content_brief": "Pick quotes you have the right to publish: your own lines, a client with permission, or a clearly attributed public statement. Keep quote_text under 140 characters so it stays at display size, and cut filler words before you shorten the type. quote_author is the name only; quote_source carries the role, company or year in uppercase. Use the cover for the series promise, not the first quote. Close with one ask, either save or follow, never both.",
  "format": "carousel",
  "aspect_ratio": "1:1",
  "appearance": "dark",
  "category": "quote",
  "slide_count": 3,
  "min_slides": 3,
  "max_slides": 10,
  "platform_fit": [
    "instagram",
    "facebook",
    "linkedin"
  ],
  "style_tags": [
    "full_bleed_photo",
    "bold_type",
    "minimal"
  ],
  "use_when": [
    "brand_storytelling",
    "audience_education",
    "weekly_series"
  ],
  "keywords": [
    "quote",
    "photo",
    "full bleed",
    "series",
    "dark",
    "carousel",
    "attribution"
  ],
  "industry_fit": [
    "creator",
    "agency",
    "education",
    "fitness"
  ],
  "slides": [
    {
      "index": 1,
      "role": "hook",
      "layout_note": "Cover: full-bleed image slot under a top-and-bottom scrim, kicker and marker dot on the top row, display title with a supporting line anchored to the lower third.",
      "repeatable": false,
      "slots": [
        {
          "name": "cover_image",
          "type": "image_slot",
          "required": false,
          "hint": "Portrait or scene with room in the upper half; the scrim protects the lower third."
        },
        {
          "name": "series_kicker",
          "type": "kicker",
          "max_chars": 26,
          "required": false,
          "hint": "Series label in uppercase.",
          "example": "Voices at work"
        },
        {
          "name": "hook_headline",
          "type": "headline",
          "max_chars": 60,
          "required": true,
          "hint": "The promise of the series, stated plainly.",
          "example": "Four lines that changed how we hire"
        },
        {
          "name": "hook_subline",
          "type": "subhead",
          "max_chars": 90,
          "required": false,
          "hint": "Context: who is speaking or where the quotes come from.",
          "example": "Collected from our hiring managers over one quarter."
        }
      ]
    },
    {
      "index": 2,
      "role": "content",
      "layout_note": "Quote slide: full-bleed image slot with scrim, opening quote glyph in the accent colour, display-scale quote and an attribution row with an accent rule, name and source line.",
      "repeatable": true,
      "slots": [
        {
          "name": "quote_image",
          "type": "image_slot",
          "required": false,
          "hint": "Image of the speaker or a related scene; keep the subject in the upper half."
        },
        {
          "name": "quote_text",
          "type": "quote",
          "max_chars": 140,
          "required": true,
          "hint": "One sentence, no quotation marks; the template draws the glyph.",
          "example": "We stopped asking for years of experience and started asking for one thing they had shipped."
        },
        {
          "name": "quote_author",
          "type": "subhead",
          "max_chars": 30,
          "required": true,
          "hint": "Name of the speaker.",
          "example": "Nadia Alvarez"
        },
        {
          "name": "quote_source",
          "type": "kicker",
          "max_chars": 34,
          "required": false,
          "hint": "Role, company or year in uppercase.",
          "example": "Head of people"
        }
      ]
    },
    {
      "index": 3,
      "role": "cta",
      "layout_note": "Closing slide: flat accent panel with a display ask, a pill button in the contrast colour and the handle underneath.",
      "repeatable": false,
      "slots": [
        {
          "name": "cta_message",
          "type": "headline",
          "max_chars": 55,
          "required": true,
          "hint": "Ask tied to the value of the series.",
          "example": "Which line would your team steal?"
        },
        {
          "name": "cta_action",
          "type": "cta",
          "max_chars": 20,
          "required": true,
          "hint": "Two or three words, imperative.",
          "example": "Follow the series"
        },
        {
          "name": "profile_handle",
          "type": "handle",
          "max_chars": 24,
          "required": false,
          "hint": "Account handle with @.",
          "example": "@northloopteam"
        }
      ]
    }
  ],
  "fonts": [
    {
      "role": "display",
      "family": "Manrope",
      "google_font": true,
      "weights": [
        500,
        800
      ],
      "fallback": "sans-serif"
    },
    {
      "role": "body",
      "family": "Inter",
      "google_font": true,
      "weights": [
        400,
        500
      ],
      "fallback": "sans-serif"
    }
  ],
  "html_template": "<link href=\"https://fonts.googleapis.com/css2?family=Manrope:wght@500;800&family=Inter:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n:root { --bg: #111214; --surface: #4e596d; --accent: #f2c14e; --accent-contrast: #111214; --text-primary: #ffffff; --text-secondary: #b9bcc4; --font-display: 'Manrope', sans-serif; --font-body: 'Inter', sans-serif; }\n* { margin: 0; box-sizing: border-box; }\n.slide { width: 1080px; height: 1080px; background: var(--bg); color: var(--text-primary); font-family: var(--font-body); position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; padding: 84px; }\n.media { position: absolute; inset: 0; background: linear-gradient(145deg, var(--surface) 0%, var(--bg) 52%, var(--surface) 100%); }\n.media::after { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(115deg, rgba(255,255,255,.05) 0 28px, rgba(0,0,0,0) 28px 64px); }\n.scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.52) 0%, rgba(0,0,0,.06) 32%, rgba(0,0,0,.84) 100%); }\n.top { position: absolute; top: 84px; left: 84px; right: 84px; display: flex; justify-content: space-between; align-items: center; z-index: 2; }\n.kicker { font-size: 26px; font-weight: 500; letter-spacing: .3em; text-transform: uppercase; color: var(--accent); }\n.dot { width: 20px; height: 20px; border-radius: 50%; border: 4px solid var(--accent); }\n.block { position: relative; z-index: 2; }\n.title { font-family: var(--font-display); font-weight: 800; font-size: 84px; line-height: 1.08; letter-spacing: -.02em; }\n.sub { margin-top: 30px; max-width: 780px; font-size: 32px; line-height: 1.45; color: var(--text-secondary); }\n.mark { font-family: var(--font-display); font-weight: 800; font-size: 120px; line-height: .62; color: var(--accent); }\n.quote { margin-top: 30px; font-family: var(--font-display); font-weight: 800; font-size: 64px; line-height: 1.18; letter-spacing: -.015em; }\n.attrib { margin-top: 42px; display: flex; align-items: center; gap: 24px; }\n.attrib .bar { width: 72px; height: 5px; background: var(--accent); flex: none; }\n.name { font-size: 34px; font-weight: 500; }\n.role { font-size: 25px; letter-spacing: .14em; text-transform: uppercase; color: var(--text-secondary); }\n.closing { background: var(--accent); color: var(--accent-contrast); justify-content: center; }\n.closing .block { display: flex; flex-direction: column; align-items: flex-start; }\n.cta-msg { font-family: var(--font-display); font-weight: 800; font-size: 82px; line-height: 1.1; letter-spacing: -.02em; }\n.btn { margin-top: 46px; align-self: flex-start; background: var(--accent-contrast); color: var(--accent); font-size: 34px; font-weight: 500; padding: 26px 52px; border-radius: 999px; }\n.handle { margin-top: 34px; font-size: 30px; letter-spacing: .04em; }\n</style>\n<section class=\"slide\" data-slide=\"1\" data-role=\"hook\">\n  <div class=\"media\" data-slot=\"cover_image\"></div>\n  <div class=\"scrim\"></div>\n  <div class=\"top\"><span class=\"kicker\" data-optional=\"true\">{{series_kicker}}</span><span class=\"dot\"></span></div>\n  <div class=\"block\">\n    <h1 class=\"title\">{{hook_headline}}</h1>\n    <p class=\"sub\" data-optional=\"true\">{{hook_subline}}</p>\n  </div>\n</section>\n<section class=\"slide\" data-slide=\"2\" data-role=\"content\" data-repeat=\"true\">\n  <div class=\"media\" data-slot=\"quote_image\"></div>\n  <div class=\"scrim\"></div>\n  <div class=\"block\">\n    <div class=\"mark\">&#8220;</div>\n    <p class=\"quote\">{{quote_text}}</p>\n    <div class=\"attrib\">\n      <span class=\"bar\"></span>\n      <span>\n        <span class=\"name\">{{quote_author}}</span><br>\n        <span class=\"role\" data-optional=\"true\">{{quote_source}}</span>\n      </span>\n    </div>\n  </div>\n</section>\n<section class=\"slide closing\" data-slide=\"3\" data-role=\"cta\">\n  <div class=\"block\">\n    <h2 class=\"cta-msg\">{{cta_message}}</h2>\n    <span class=\"btn\">{{cta_action}}</span>\n    <span class=\"handle\" data-optional=\"true\">{{profile_handle}}</span>\n  </div>\n</section>\n",
  "source": "other",
  "source_url": "https://www.figma.com/design/uL4295tZxw0jtgVVYfSnii/?node-id=10-492",
  "source_note": "Full-bleed photo quote layout pattern observed in a Figma community file; no source imagery used, all markup, styling and copy original.",

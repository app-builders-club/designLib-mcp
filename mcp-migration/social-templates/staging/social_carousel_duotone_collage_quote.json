    "fitness"
  ],
  "slides": [
    {
      "index": 1,
      "role": "hook",
      "layout_note": "Cover: tilted tile collage under a duotone tint and vertical scrim, series kicker on the top edge, centred condensed quote in the optical middle, swipe cue on the bottom edge.",
      "repeatable": false,
      "slots": [
        {
          "name": "cover_collage",
          "type": "image_slot",
          "required": false,
          "hint": "Optional tile imagery; the CSS gradient tiles are the default backdrop and the tint unifies whatever is dropped in."
        },
        {
          "name": "series_kicker",
          "type": "kicker",
          "max_chars": 26,
          "required": false,
          "hint": "Series or theme label, uppercase.",
          "example": "Late night notes"
        },
        {
          "name": "hook_quote",
          "type": "quote",
          "max_chars": 100,
          "required": true,
          "hint": "The strongest line of the set; the template adds the quotation marks.",
          "example": "Nobody remembers the plan, they remember whether you shipped it"
        }
      ]
    },
    {
      "index": 2,
      "role": "content",
      "layout_note": "Quote slide: same collage backdrop, ringed index numeral above a centred condensed quote, attribution line in uppercase underneath.",
      "repeatable": true,
      "slots": [
        {
          "name": "quote_collage",
          "type": "image_slot",
          "required": false,
          "hint": "Optional tile imagery for this slide; keep the same treatment across the set."
        },
        {
          "name": "quote_index",
          "type": "stat",
          "max_chars": 2,
          "required": true,
          "hint": "Two-digit counter, ascending.",
          "example": "02"
        },
        {
          "name": "quote_text",
          "type": "quote",
          "max_chars": 110,
          "required": true,
          "hint": "One line that reads well in caps, no quotation marks.",
          "example": "Deadlines do not create urgency, they only reveal who felt it already"
        },
        {
          "name": "quote_author",
          "type": "subhead",
          "max_chars": 30,
          "required": false,
          "hint": "Who said it, uppercase; omit for your own lines.",
          "example": "Marek Sandoval"
        }
      ]
    },
    {
      "index": 3,
      "role": "cta",
      "layout_note": "Closing slide: collage dimmed behind a bordered panel holding the ask, an accent pill button and the handle.",
      "repeatable": false,
      "slots": [
        {
          "name": "cta_collage",
          "type": "image_slot",
          "required": false,
          "hint": "Optional tile imagery behind the closing panel."
        },
        {
          "name": "cta_message",
          "type": "headline",
          "max_chars": 50,
          "required": true,
          "hint": "Ask in the voice of the set.",
          "example": "Which one hit hardest?"
        },
        {
          "name": "cta_action",
          "type": "cta",
          "max_chars": 20,
          "required": true,
          "hint": "Two or three words, imperative.",
          "example": "Save the set"
        },
        {
          "name": "profile_handle",
          "type": "handle",
          "max_chars": 24,
          "required": false,
          "hint": "Account handle with @.",
          "example": "@paperlanternco"
        }
      ]
    }
  ],
  "fonts": [
    {
      "role": "display",

{
  "id": "social_carousel_duotone_collage_quote",
  "title": "Duotone Collage Quote Carousel",
  "description": "Quote carousel over a tilted tile collage tinted to a single duotone hue. Condensed uppercase type sits centred above the pattern, with a ringed index numeral marking each quote and a bordered panel closing the set. The collage is drawn in CSS, so it works with or without user imagery.",
  "why_it_works": "The tilted grid gives the frame motion while the duotone tint flattens it into one colour field, which keeps centred type readable over busy content. Condensed uppercase fits more words per line at display size, so a full sentence still lands as a poster. The numbered ring tells the viewer where they are in the set and invites the next swipe.",
  "content_brief": "Use short, punchy lines that survive uppercase: aphorisms, hot takes, lines from your own writing. Keep hook_quote under 100 characters and quote_text under 110, and prefer plain words over clever ones because condensed caps lose subtlety. quote_index is a two-digit counter starting at 01. Attribute every borrowed line with quote_author; drop the field only for your own words. Close with a single ask and no hashtag block.",
  "format": "carousel",
  "aspect_ratio": "1:1",
  "appearance": "dark",
  "category": "quote",
  "slide_count": 3,
  "min_slides": 3,
  "max_slides": 10,
  "platform_fit": [
    "instagram",
    "tiktok",
    "facebook"
  ],
  "style_tags": [
    "duotone",
    "collage",
    "bold_type"
  ],
  "use_when": [
    "content_repurposing",
    "brand_storytelling",
    "community_engagement"
  ],
  "keywords": [
    "quote",
    "duotone",
    "collage",
    "tilted grid",
    "condensed",
    "poster",
    "carousel",
    "dark"
  ],
  "industry_fit": [
    "creator",
    "fashion",
